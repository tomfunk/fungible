PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_secret
PLAID_ENV=sandbox  # Use 'sandbox' for testing, 'production' for real bank data (Plaid deprecated the 'development' tier)

# Agent — set one of these to enable the AI chat panel
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override the default model (anthropic=claude-haiku-4-5-20251001, openai=gpt-5.4-nano)
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-5.5

# Web app (web/) — URL of the hosted sync server. Opt-in: when unset, the web
# app is purely local (no account UI, no network requests). Setting it enables
# the hosted-sync Connect UI.
# VITE_FUNGIBLE_SYNC_URL=http://localhost:3000

# TUI / desktop app — URL of the hosted sync server. Opt-in: when unset, sync
# stays off and everything is purely local.
# FUNGIBLE_SYNC_URL=
